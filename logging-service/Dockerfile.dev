FROM golang:1.24-alpine

WORKDIR /app

# Install hot reload tool
RUN go install github.com/air-verse/air@latest

# Copy all files from project root (needed for local module dependencies)
COPY . .

# Set working directory to logging-service
WORKDIR /app/logging-service

# Download dependencies
RUN go mod download

# Expose port
EXPOSE 50052

# Use air for hot reloading in development
CMD ["air", "-c", ".air.toml"]