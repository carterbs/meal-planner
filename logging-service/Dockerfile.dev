FROM golang:1.24-alpine

WORKDIR /app

# Install a hot reload tool version that supports Go 1.24
RUN go install github.com/air-verse/air@v1.62.0

# Copy all files from project root (needed for local module dependencies)
COPY . .

# Set working directory to logging-service
WORKDIR /app/logging-service

# Download dependencies
RUN go mod download

# Expose port
EXPOSE 50052

# Use air for hot reloading in development
CMD ["air", "-c", ".air.toml"]
