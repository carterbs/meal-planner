FROM golang:1.22-alpine AS builder

# Preserve the exact repo layout
WORKDIR /repo

# Copy the entire repo to maintain structure
COPY . .

# Build from the backend directory
WORKDIR /repo/backend
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o mealplanner .

# Use a smaller image for the final build
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /root/

# Copy the binary from the builder stage
COPY --from=builder /repo/backend/mealplanner .
COPY --from=builder /repo/backend/migrations ./migrations

# Expose the port
EXPOSE 8090

# Set environment variables
ENV GIN_MODE=release

# Run the application
CMD ["./mealplanner"]
