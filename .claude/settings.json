{
  "permissions": {
    "allowedTools": [
      "Edit",
      "Bash(git status)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr*)",
      "Bash(gh issue*)",
      "Read",
      "Write",
      "Glob",
      "Grep",
      "LS",
      "tools/validate/validate"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read file_path; $CLAUDE_PROJECT_DIR/tools/validate/validate lint-file \"$file_path\"; }"
          }
        ]
      }
    ]
  }
}