{
    "name": "mealplanner",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "frontend",
        "backend/mcp",
        "agent"
    ],
    "scripts": {
        "start": "node scripts/start.js",
        "start:mcp": "node scripts/start-mcp.js",
        "test:backend": "cd backend && go test -v ./...",
        "test:frontend": "cd frontend && yarn test",
        "test:agent": "cd agent && yarn test",
        "build:agent": "cd agent && yarn build",
        "test": "node scripts/test-summary.js",
        "db:backup": "node scripts/backup-db.js",
        "db:restore": "node scripts/restore-db.js",
        "dev": "node scripts/dev-start.js",
        "meal-agent": "./scripts/meal-agent.sh",
        "kill:servers": "node scripts/kill-servers.js",
        "format": "prettier --write \"agent/**/*.{ts,tsx}\" \"frontend/**/*.{ts,tsx}\""
    },
    "devDependencies": {
        "chalk": "^4.1.2",
        "concurrently": "^7.6.0",
        "prettier": "^3.6.2",
        "wait-on": "^7.1.0"
    },
    "packageManager": "yarn@4.9.1"
}
