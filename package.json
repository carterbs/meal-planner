{
    "name": "mealplanner",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "ui",
        "mcp-service",
        "shared",
        "generated/ts",
        "generated/ts/gateway",
        "logging-service/client/ts",
        "agent-service"
    ],
    "scripts": {
        "dev": "docker-compose up -d && cd ui && yarn start",
        "generate_code": "./scripts/generate_code.sh",
        "dev:rebuild": "docker-compose down && yarn generate_code && docker-compose build && docker-compose up -d && cd ui && yarn start",
        "dev:logs": "docker-compose logs -f",
        "dev:down": "docker-compose down",
        "dev:restart": "docker-compose restart",
        "start:mcp": "node scripts/start-mcp.js",
        "start:agent": "cd agent-service && yarn start",
        "stop:logging": "kill -9 $(lsof -t -i :50052)",
        "test:e2e": "ts-node ./e2e/e2e_remove_friday.ts",
        "test:backend": "cd meal-service && make test",
        "test:mcp": "cd mcp-service && yarn test",
        "test:frontend": "cd ui && yarn test",
        "test:agent": "cd agent-service && yarn test",
        "build:agent": "cd agent-service && yarn build",
        "build:mcp": "cd mcp-service && yarn build",
        "test": "node scripts/test-summary.js",
        "db:backup": "node scripts/backup-db.js",
        "db:restore": "node scripts/restore-db.js",
        "meal-agent": "./scripts/meal-agent.sh",
        "kill:servers": "node scripts/kill-servers.js",
        "format": "prettier --write \"agent-service/**/*.{ts,tsx}\" \"ui/**/*.{ts,tsx}\" && gofmt -w meal-service/",
        "lint": "make lint",
        "swagger": "make swagger",
        "generate": "make generate"
    },
    "resolutions": {
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^1.10.0",
        "@hey-api/openapi-ts": "^0.78.3",
        "@types/node": "^24.0.13",
        "chalk": "^4.1.2",
        "concurrently": "^7.6.0",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "ts-proto": "^2.7.5",
        "typescript": "^5.8.3",
        "wait-on": "^7.1.0"
    },
    "packageManager": "yarn@4.9.1",
    "dependencies": {
        "@bufbuild/protobuf": "^1.10.0",
        "@connectrpc/connect": "^1.6.0",
        "@connectrpc/connect-node": "^1.6.0",
        "@connectrpc/connect-web": "^1.6.0",
        "@connectrpc/protoc-gen-connect-es": "^1.6.1",
        "eventsource-parser": "^1.1.2"
    }
}
