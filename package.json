{
    "name": "mealplanner",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "frontend",
        "backend/mcp",
        "agent"
    ],
    "scripts": {
        "start": "node scripts/start.js",
        "start:mcp": "node scripts/start-mcp.js",
        "test:backend": "cd backend && go test -v ./...",
