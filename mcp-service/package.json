{
  "name": "mcp",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint -c .eslintrc.cjs src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint -c .eslintrc.cjs src --ext .ts,.tsx --fix"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.0",
    "@connectrpc/connect-node": "^1.6.0",
    "@connectrpc/connect-web": "^1.6.0",
    "@jest/globals": "^30.0.5",
    "@mealplanner/generated": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^30.0.0",
    "jest-fetch-mock": "^3.0.3",
    "nock": "^13.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
