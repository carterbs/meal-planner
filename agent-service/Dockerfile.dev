FROM node:22-alpine

WORKDIR /app

# Dependencies like tree-sitter need build tooling on Alpine
RUN apk add --no-cache build-base python3

# Enable corepack for proper yarn version
RUN corepack enable

# Copy root package files (yarn workspaces)
COPY package.json yarn.lock ./
COPY agent-service/package.json ./agent-service/
COPY shared/package.json ./shared/
COPY generated/ts/package.json ./generated/ts/

# Install all workspace dependencies
RUN yarn install

# Copy source code
COPY agent-service/ ./agent-service/
COPY shared/ ./shared/
COPY generated/ ./generated/
COPY proto/ ./proto/

# Build from root to ensure workspace linking works
RUN yarn workspace @mealplanner/generated install
RUN yarn workspace meal-planner-agent-service build

# Expose port
EXPOSE 50053

# Use nodemon for hot reloading in development
CMD ["yarn", "start:grpc"]
