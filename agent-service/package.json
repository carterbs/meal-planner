{
  "name": "meal-planner-agent-service",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/langgraph-agent.js",
    "start:grpc": "node --env-file=.env dist/main.js",
    "cli": "node --env-file=.env dist/cli.js",
    "dev": "tsx --env-file=.env langgraph-agent.ts",
    "dev:grpc": "tsx --env-file=.env main.ts",
    "dev:cli": "tsx --env-file=.env cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.0",
    "@connectrpc/connect-node": "^1.6.0",
    "@connectrpc/connect-web": "^1.6.0",
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.8",
    "@langchain/core": "^0.2.0",
    "@langchain/langgraph": "^0.0.20",
    "@langchain/openai": "^0.1.0",
    "@mealplanner/generated": "file:../generated/ts",
    "@modelcontextprotocol/sdk": "1.12.3",
    "commander": "^14.0.0",
    "dotenv": "^16.5.0",
    "pg": "^8.11.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
