FROM golang:1.24-alpine

WORKDIR /app

# Install a hot reload tool version compatible with Go 1.24
RUN go install github.com/air-verse/air@v1.62.0

# Copy all files from project root (needed for local module dependencies)
COPY . .

# Set working directory to meal-service
WORKDIR /app/meal-service

# Download dependencies
RUN go mod download

# Expose port
EXPOSE 8080

# Use air for hot reloading in development
CMD ["air", "-c", ".air.toml"]
